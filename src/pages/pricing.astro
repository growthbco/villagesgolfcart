rip a{font-size:13px;text-decoration:none!important}.section{padding:80px 0;border-bottom:1px solid #dce2d6;scroll-margin-top:24px}.guide h2{font-size:clamp(30px,4vw,46px);line-height:1.12;font-weight:500;letter-spacing:-.045em;text-transform:none;margin:0 0 23px;max-width:650px}.guide h3{font-size:27px;line-height:1.2;font-weight:500;letter-spacing:-.035em;text-transform:none;margin:0 0 15px}.guide p,.guide li{font-size:16px;line-height:1.75}.guide p{margin:0 0 18px}.lead{max-width:640px;color:#637064}.step{display:block;font-size:10px;font-weight:700;letter-spacing:.18em;color:#61774e;margin-bottom:20px}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:25px;margin-top:38px}.card{border-radius:9px;background:#f0f2ea;overflow:hidden;border:1px solid #e2e7dc}.card img{width:100%;height:260px;object-fit:cover;transition:transform .3s}.card:hover img{transform:scale(1.025)}.card-body{padding:25px}.card-label{display:block;font-size:9px;font-weight:700;letter-spacing:.13em;color:#6c795e;margin-bottom:14px}.card p{font-size:15px;color:#5d6b5f}.card a{display:block;border-top:1px solid #d4ddcd;padding-top:18px;font-size:14px;font-weight:700;text-decoration:none!important}.card a:after{content:' ↗';float:right}.split{display:grid;grid-template-columns:1fr 1fr;gap:80px}.note{padding:30px 36px;background:#e7ecdd;border-radius:6px}.guide ul{list-style:disc;padding-left:20px}.guide li+li{margin-top:12px}.guide a:not(.button){color:#193b30;text-decoration:underline;text-underline-offset:5px}.guide details{border-bottom:1px solid #d5ddcd;padding:22px 0;max-width:900px}.guide summary{font-size:19px;cursor:pointer;font-weight:500}.guide details p{max-width:760px;color:#526258;margin-top:20px}.links{display:flex;gap:25px;margin-top:25px;font-size:14px;font-weight:700}.closing{background:#193b30;color:#fff;padding:58px 0}.closing .wrap{position:relative}.closing p{color:#d4dfcc}.closing .button{background:#dce9bc;color:#193b30!important}.guide a:focus-visible,.guide summary:focus-visible{outline:3px solid #b87920;outline-offset:5px}@media(prefers-reduced-motion:reduce){.card img{transition:none}}@media(max-width:750px){.hero-grid,.cards,.split{grid-template-columns:1fr;gap:30px}.wrap{padding:0 22px}.hero{padding:15px 0 30px}.hero h1{font-size:62px}.hero-copy{padding:18px 0 0}.hero-photo{height:420px;border-radius:100px 10px 10px 10px}.hero-actions{gap:20px;flex-wrap:wrap}.hero-footnote{font-size:11px!important}.planning-strip .wrap{flex-wrap:wrap;gap:15px}.planning-strip span{width:100%}.planning-strip a{font-size:11px}.section{padding:48px 0}.card img{height:280px}.note{padding:24px}.guide h2{font-size:34px}}
