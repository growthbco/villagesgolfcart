const content = {"eyebrow": "Extended stays / The Villages", "heading": "Plan beyond the first month.", "intro": "For an extended visit or seasonal stay in The Villages, request a quote based on the full time you expect to need a cart.", "image": "/cart-images/hero-villages.webp", "imageAlt": "Golf cart on a shaded path", "sections": [{"title": "Compare the full rental period.", "body": "Share start and end dates and ask for the total for the full period. Confirm how changes to your dates would affect availability and price."}, {"title": "Know how to reach the team.", "body": "Before delivery, confirm the contact number and support arrangements for your rental. If a problem arises, describe what happened and where the cart is located."}, {"title": "Coordinate the return.", "body": "Confirm the pickup location and timing before the end of the rental. Contact the team in advance if you want to extend your stay."}], "links": [{"label": "Compare carts & pricing", "href": "/pricing/"}, {"label": "Weekly rentals", "href": "/weekly-golf-cart-rental-villages/"}, {"label": "Monthly rentals", "href": "/monthly-golf-cart-rental-villages/"}, {"label": "Contact the rental team", "href": "/contact/"}], "phone": "(352) 306-4409", "tel": "+13523064409"};
