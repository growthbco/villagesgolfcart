---
interface Props { eyebrow: string; heading: string; intro: string; image: string; imageAlt: string; sections: {title:string;body:string}[]; links: {label:string;href:string}[]; phone:string; tel:string; }
const {eyebrow,heading,intro,image,imageAlt,sections,links,phone,tel}=Astro.props;
---
<article class="rental-story"><header class="story-hero"><div><p class="eyebrow">{eyebrow}</p><h1>{heading}</h1><p class="intro">{intro}</p><a class="primary" href="/contact/">Request availability <span aria-hidden="true">↗</span></a><a class="phone" href={`tel:${tel}`}>Or call {phone}</a></div><img src={image} alt={imageAlt} width="1080" height="1350" fetchpriority="high"/></header><section class="story-content" aria-label="Plan your rental">{sections.map((section,index)=><div class="story-row"><span class="number">0{index+1}</span><h2>{section.title}</h2><p>{section.body}</p></div>)}</section><nav class="story-links" aria-label="Explore rental options"><h2>Find the details you need.</h2><div>{links.map(link=><a href={link.href}>{link.label}<span aria-hidden="true">↗</span></a>)}</div></nav><section class="story-cta"><p class="eyebrow">LET’S PLAN YOUR RENTAL</p><h2>Have your dates ready?</h2><p>Send your dates, passenger count and delivery area. We’ll discuss availability and pricing before you reserve.</p><a class="primary" href="/contact/">Request availability <span aria-hidden="true">↗</span></a></section></article>
<style>
.rental-story{background:#fbfaf6;color:#193b30;font-family:Arial,sans-serif}.story-hero{max-width:1200px;margin:auto;padding:54px 28px 64px;display:grid;grid-template-columns:1fr 1fr;gap:65px;align-items:center}.eyebrow{font-size:11px;letter-spacing:.15em;font-weight:700;text-transform:uppercase}.story-hero h1{font-size:clamp(42px,5.5vw,72px);font-weight:500;line-height:1.04;letter-spacing:-.05em;margin:25px 0}.intro{font-size:19px;line-height:1.7;color:#53685b;max-width:490px}.story-hero img{height:500px;width:100%;object-fit:cover;border-radius:120px 10px 10px 10px}.primary{display:inline-flex;gap:30px;background:#193b30;color:#fff;padding:17px 23px;border-radius:5px;font-size:15px;font-weight:700;margin-top:24px}.phone{display:block;margin-top:20px;font-size:14px;text-decoration:underline;text-underline-offset:4px}.story-content{max-width:1200px;margin:auto;padding:20px 28px 60px}.story-row{display:grid;grid-template-columns:60px 1fr 1.4fr;gap:30px;padding:35px 0;border-top:1px solid #cbd6c3}.number{font-size:12px;color:#6c8159;padding-top:7px}.story-row h2{font-size:28px;font-weight:500;line-height:1.2;letter-spacing:-.03em}.story-row p{font-size:17px;line-height:1.75;color:#526557}.story-links{background:#e9eedf;padding:55px max(28px,calc((100% - 1144px)/2))}.story-links h2,.story-cta h2{font-size:36px;font-weight:500;letter-spacing:-.04em;margin-bottom:24px}.story-links>div{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.story-links a{padding:22px 0;border-top:1px solid #b8c8ac;font-size:16px;display:flex;gap:20px;justify-content:space-between}.story-cta{background:#193b30;color:#fff;padding:60px max(28px,calc((100% - 1144px)/2))}.story-cta p{max-width:620px;line-height:1.7}.story-cta .primary{background:#dce8bd;color:#193b30}.rental-story a:focus-visible{outline:3px solid #bc8326;outline-offset:5px}@media(max-width:750px){.story-hero{grid-template-columns:1fr;padding:35px 22px;gap:30px}.story-hero img{height:350px}.story-hero h1{font-size:45px}.story-row{grid-template-columns:30px 1fr;gap:15px}.story-row p{grid-column:2}.story-content{padding:20px 22px 35px}.story-links>div{grid-template-columns:1fr}.story-links,.story-cta{padding:40px 22px}}
</style>